# Runtime assets for the Tesollo DELTO environments are committed directly.
!source/uwlab_assets/uwlab_assets/local/Robots/DeltoHand/delto_hand.usd
!source/uwlab_assets/uwlab_assets/local/Robots/Ur10eDelto/ur10e_delto.usd
