index 238253b..eab933d 100644
--- a/source/isaaclab_newton/isaaclab_newton/physics/newton_manager.py
+++ b/source/isaaclab_newton/isaaclab_newton/physics/newton_manager.py
@@ -19,13 +19,42 @@ import warp as wp
 # Load CUDA runtime for relaxed-mode graph capture (RTX-compatible).
 # cudaStreamCaptureModeRelaxed (2) allows the RTX compositor's background
 # CUDA stream to keep running during capture without invalidating it.
-try:
-    _cudart = ctypes.CDLL("libcudart.so.12")
-except OSError:
-    try:
-        _cudart = ctypes.CDLL("libcudart.so")
-    except OSError:
-        _cudart = None
+def _load_cudart():
+    """Locate the CUDA runtime for relaxed-mode graph capture.
+
+    UWLAB PORT NOTE: upstream tries only ``libcudart.so.12`` and the unversioned
+    ``libcudart.so``. Isaac Sim 6.0 / torch cu130 ship CUDA **13**, and the pip
+    wheels install ``libcudart.so.13`` under ``site-packages/nvidia/cu13/lib``
+    with no unversioned symlink and that directory not on the loader path. So
+    both upstream attempts fail, graph capture is silently disabled, and Newton
+    falls back to eager execution -- which costs a large part of its speed
+    advantage while looking like a mere warning.
+    """
+    import glob
+    import os
+    import sysconfig
+
+    names = ["libcudart.so.13", "libcudart.so.12", "libcudart.so"]
+    for name in names:
+        try:
+            return ctypes.CDLL(name)
+        except OSError:
+            pass
+    # Fall back to the pip-installed CUDA runtime, wherever this interpreter put it.
+    roots = [sysconfig.get_paths().get("purelib", ""), sysconfig.get_paths().get("platlib", "")]
+    for root in filter(None, roots):
+        for pattern in ("nvidia/cu*/lib/libcudart.so*", "nvidia/cuda_runtime/lib/libcudart.so*"):
+            for path in sorted(glob.glob(os.path.join(root, pattern)), reverse=True):
+                if path.endswith(".a"):
+                    continue
+                try:
+                    return ctypes.CDLL(path)
+                except OSError:
+                    pass
+    return None
+
+
+_cudart = _load_cudart()
